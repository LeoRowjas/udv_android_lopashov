<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sdam.Views.DonePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Sdam.ViewModels"
    x:DataType="vm:DoneViewModel"
    Title="Сдано">

    <Grid>
        <CollectionView
            ItemsSource="{Binding Items}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedItem}"
            IsVisible="{Binding HasItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AssignmentItem">
                    <Grid
                        Style="{StaticResource ListItem}"
                        Padding="20,12,20,0"
                        ColumnDefinitions="Auto,*,Auto"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12">
                        <BoxView
                            Grid.RowSpan="2"
                            Color="{Binding SubjectColor}"
                            WidthRequest="12"
                            HeightRequest="12"
                            CornerRadius="6"
                            VerticalOptions="Start"
                            Margin="0,6,0,0" />
                        <Label Grid.Column="1" Style="{StaticResource ItemTitle}" Text="{Binding Title}" />
                        <Label Grid.Column="1" Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                        <Label Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding DueText}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            HeightRequest="1"
                            Color="{StaticResource Rule}"
                            Margin="0,12,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout
            IsVisible="{Binding IsEmpty}"
            VerticalOptions="Center"
            Padding="32"
            Spacing="10">
            <Label Style="{StaticResource Title2}" Text="Здесь будут сданные задания" HorizontalTextAlignment="Center" />
            <Label
                Style="{StaticResource Caption}"
                Text="Откройте задание в ленте и нажмите «Сдано»"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
