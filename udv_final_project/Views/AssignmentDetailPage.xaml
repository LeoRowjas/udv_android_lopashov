<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sdam.Views.AssignmentDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Sdam.ViewModels"
    x:DataType="vm:AssignmentDetailViewModel"
    Title="Задание">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Изменить" Command="{Binding EditCommand}" />
        <ToolbarItem Text="Удалить" Command="{Binding DeleteCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,8,20,20" Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <BoxView
                        Color="{Binding SubjectColor}"
                        WidthRequest="12"
                        HeightRequest="12"
                        CornerRadius="6"
                        VerticalOptions="Center" />
                    <Label Style="{StaticResource Caption}" Text="{Binding SubjectName}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Style="{StaticResource TitleXL}" Text="{Binding Title}" />
                <Label
                    Text="{Binding StatusText}"
                    TextColor="{Binding StatusColor}"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    Margin="0,0,0,12" />

                <BoxView HeightRequest="1" Color="{StaticResource Rule}" />
                <Label Style="{StaticResource FieldLabel}" Text="Срок" />
                <Label Text="{Binding DeadlineText}" TextColor="{Binding DeadlineColor}" Margin="0,0,0,10" />

                <BoxView HeightRequest="1" Color="{StaticResource Rule}" />
                <Label Style="{StaticResource FieldLabel}" Text="Тип" />
                <Label Text="{Binding TypeName}" Margin="0,0,0,10" />

                <BoxView HeightRequest="1" Color="{StaticResource Rule}" />
                <Label Style="{StaticResource FieldLabel}" Text="Приоритет" />
                <Label Text="{Binding PriorityName}" Margin="0,0,0,10" />

                <VerticalStackLayout IsVisible="{Binding HasNote}" Spacing="6">
                    <BoxView HeightRequest="1" Color="{StaticResource Rule}" />
                    <Label Style="{StaticResource FieldLabel}" Text="Заметка" />
                    <Label Text="{Binding Note}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="1"
            Text="{Binding DoneButtonText}"
            Command="{Binding ToggleDoneCommand}"
            Margin="20,8,20,20" />
    </Grid>

</ContentPage>
