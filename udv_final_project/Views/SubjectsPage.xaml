<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sdam.Views.SubjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Sdam.ViewModels"
    x:DataType="vm:SubjectsViewModel"
    Title="Предметы">

    <Grid>
        <CollectionView
            ItemsSource="{Binding Items}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedItem}"
            IsVisible="{Binding HasItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubjectItem">
                    <Grid
                        Style="{StaticResource ListItem}"
                        Padding="20,16,20,0"
                        ColumnDefinitions="Auto,*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="2">
                        <BoxView
                            Color="{Binding Color}"
                            WidthRequest="12"
                            HeightRequest="12"
                            CornerRadius="6"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource ItemTitle}" Text="{Binding Name}" />
                        <Label
                            Grid.Column="2"
                            Style="{StaticResource Caption}"
                            Text="{Binding ProgressText}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource Caption}"
                            Text="{Binding Teacher}"
                            IsVisible="{Binding HasTeacher}" />
                        <ProgressBar
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Progress="{Binding Progress}"
                            ProgressColor="{Binding Color}"
                            Margin="0,8,0,0" />
                        <BoxView
                            Grid.Row="3"
                            Grid.ColumnSpan="3"
                            HeightRequest="1"
                            Color="{StaticResource Rule}"
                            Margin="0,14,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="96" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout
            IsVisible="{Binding IsEmpty}"
            VerticalOptions="Center"
            Padding="32"
            Spacing="10">
            <Label Style="{StaticResource Title2}" Text="Пока нет предметов" HorizontalTextAlignment="Center" />
            <Label
                Style="{StaticResource Caption}"
                Text="Добавьте предметы этого семестра, чтобы записывать по ним задания"
                HorizontalTextAlignment="Center" />
            <Button
                Text="Добавить предмет"
                Command="{Binding AddCommand}"
                HorizontalOptions="Center"
                Margin="0,12,0,0" />
        </VerticalStackLayout>

        <Button
            Style="{StaticResource Fab}"
            Text="+"
            Command="{Binding AddCommand}"
            IsVisible="{Binding HasItems}"
            SemanticProperties.Description="Новый предмет" />
    </Grid>

</ContentPage>
