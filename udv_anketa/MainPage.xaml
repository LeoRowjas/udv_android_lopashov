<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="udv_anketa.MainPage"
             x:Name="_page_"
             Title="Анкета">

    <ScrollView x:Name="_scroll_">
        <VerticalStackLayout x:Name="_rootStack_"
                             Padding="20"
                             Spacing="14">

            <Image x:Name="_headerImage_"
                   Source="dotnet_bot.png"
                   Aspect="AspectFit"
                   HeightRequest="110"
                   Margin="0,0,0,4" />

            <Label x:Name="_titleLabel_"
                   Text="Анкета посетителя кофейни"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label x:Name="_subtitleLabel_"
                   Text="Поля со звёздочкой (*) обязательны"
                   FontSize="13"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6" />

            <!-- Контакты: Grid с явными строками и столбцами -->
            <Grid x:Name="_contactGrid_"
                  ColumnSpacing="12"
                  RowSpacing="4"
                  Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label x:Name="_nameLabel_"
                       Grid.Row="0" Grid.Column="0"
                       Text="Ваше имя *"
                       FontSize="15"
                       FontAttributes="Bold" />
                <Label x:Name="_phoneLabel_"
                       Grid.Row="0" Grid.Column="1"
                       Text="Телефон"
                       FontSize="15"
                       FontAttributes="Bold" />

                <Entry x:Name="_nameEntry_"
                       Grid.Row="1" Grid.Column="0"
                       Placeholder="Иван"
                       Keyboard="Text"
                       MaxLength="40" />
                <Entry x:Name="_phoneEntry_"
                       Grid.Row="1" Grid.Column="1"
                       Placeholder="+7 900 000-00-00"
                       Keyboard="Telephone"
                       MaxLength="16" />
            </Grid>

            <!-- Подписка на новости: Switch управляет доступностью Entry через x:Reference -->
            <Grid x:Name="_newsGrid_"
                  ColumnSpacing="10"
                  Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label x:Name="_newsLabel_"
                       Grid.Row="0" Grid.Column="0"
                       Text="Присылать новости и акции на почту"
                       FontSize="15"
                       FontAttributes="None"
                       VerticalOptions="Center" />
                <Switch x:Name="_newsSwitch_"
                        Grid.Row="0" Grid.Column="1"
                        IsToggled="False"
                        OnColor="#512BD4"
                        Toggled="OnNewsToggled" />
            </Grid>

            <Entry x:Name="_emailEntry_"
                   Placeholder="name@example.com"
                   Keyboard="Email"
                   MaxLength="60"
                   IsEnabled="{Binding Source={x:Reference _newsSwitch_}, Path=IsToggled, Mode=OneWay}" />

            <Label x:Name="_drinkLabel_"
                   Text="Любимый напиток *"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <Picker x:Name="_drinkPicker_"
                    Title="Выберите напиток">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Эспрессо</x:String>
                        <x:String>Капучино</x:String>
                        <x:String>Латте</x:String>
                        <x:String>Чай</x:String>
                        <x:String>Какао</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label x:Name="_timeLabel_"
                   Text="Когда обычно приходите?"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <Grid x:Name="_timeGrid_"
                  ColumnSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="_morningRadio_"
                             Grid.Row="0" Grid.Column="0"
                             Content="Утром"
                             GroupName="VisitTime"
                             Value="Утром" />
                <RadioButton x:Name="_dayRadio_"
                             Grid.Row="0" Grid.Column="1"
                             Content="Днём"
                             GroupName="VisitTime"
                             Value="Днём" />
                <RadioButton x:Name="_eveningRadio_"
                             Grid.Row="0" Grid.Column="2"
                             Content="Вечером"
                             GroupName="VisitTime"
                             Value="Вечером" />
            </Grid>

            <Label x:Name="_extrasLabel_"
                   Text="Как вы обычно заказываете?"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <HorizontalStackLayout x:Name="_syrupStack_"
                                   Spacing="8">
                <CheckBox x:Name="_syrupCheck_"
                          IsChecked="False"
                          Color="#512BD4" />
                <Label x:Name="_syrupLabel_"
                       Text="Добавляю сироп"
                       FontSize="15"
                       FontAttributes="None"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout x:Name="_takeawayStack_"
                                   Spacing="8">
                <CheckBox x:Name="_takeawayCheck_"
                          IsChecked="False"
                          Color="#2B7A4B" />
                <Label x:Name="_takeawayLabel_"
                       Text="Беру с собой"
                       FontSize="15"
                       FontAttributes="None"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="_dateLabel_"
                   Text="Дата последнего визита"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <DatePicker x:Name="_visitDatePicker_"
                        Format="dd.MM.yyyy"
                        MinimumDate="2020-01-01"
                        MaximumDate="2026-12-31"
                        Date="2026-10-10" />

            <!-- Slider + Label: привязка через x:Reference с явными Path и Mode -->
            <Label x:Name="_ratingTitleLabel_"
                   Text="Оценка кофейни"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <Slider x:Name="_ratingSlider_"
                    Minimum="1"
                    Maximum="10"
                    Value="5" />
            <Label x:Name="_ratingValueLabel_"
                   Text="{Binding Source={x:Reference _ratingSlider_}, Path=Value, Mode=OneWay, StringFormat='{0:F0} из 10'}"
                   FontSize="14"
                   FontAttributes="Italic"
                   HorizontalOptions="Center" />

            <Label x:Name="_visitsTitleLabel_"
                   Text="Сколько раз в неделю заходите?"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <HorizontalStackLayout x:Name="_visitsStack_"
                                   Spacing="16">
                <Stepper x:Name="_visitsStepper_"
                         Minimum="0"
                         Maximum="14"
                         Value="1"
                         Increment="1" />
                <Label x:Name="_visitsValueLabel_"
                       Text="{Binding Source={x:Reference _visitsStepper_}, Path=Value, Mode=OneWay, StringFormat='{0:F0}'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="_commentLabel_"
                   Text="Ваши пожелания"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0" />
            <Editor x:Name="_commentEditor_"
                    Placeholder="Напишите, что нам улучшить..."
                    AutoSize="TextChanges"
                    MaxLength="300" />

            <Label x:Name="_errorLabel_"
                   Text=""
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#C62828"
                   IsVisible="False" />

            <Grid x:Name="_buttonsGrid_"
                  ColumnSpacing="12"
                  Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="_showButton_"
                        Grid.Row="0" Grid.Column="0"
                        Text="Показать результат"
                        Clicked="OnShowClicked" />
                <Button x:Name="_clearButton_"
                        Grid.Row="0" Grid.Column="1"
                        Text="Очистить"
                        BackgroundColor="#757575"
                        Clicked="OnClearClicked" />
            </Grid>

            <Border x:Name="_resultBorder_"
                    IsVisible="False"
                    Padding="14"
                    Margin="0,4,0,20"
                    Stroke="#512BD4"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout x:Name="_resultStack_"
                                     Spacing="8">
                    <Label x:Name="_resultTitleLabel_"
                           Text="Сводка ответов"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label x:Name="_resultLabel_"
                           Text=""
                           FontSize="15"
                           FontAttributes="None" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
